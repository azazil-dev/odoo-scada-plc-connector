<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Modul Category -->
        <record id="module_category_scada_plc" model="ir.module.category">
            <field name="name">SCADA &amp; PLC Integration</field>
            <field name="description">Manajemen integrasi koneksi mesin industri, PLC, IoT Gateway, dan pemantauan telemetri.</field>
            <field name="sequence">25</field>
        </record>

        <!-- 1. SCADA Viewer: Operator Produksi (Melihat status mesin & jumlah produksi live) -->
        <record id="group_scada_viewer" model="res.groups">
            <field name="name">SCADA Viewer</field>
            <field name="category_id" ref="module_category_scada_plc"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Akses hanya-lihat ke dashboard mesin, nilai tag live, dan alarm aktif.</field>
        </record>

        <!-- Pastikan semua Internal User (base.group_user) mendapatkan hak viewer secara default agar menu SCADA langsung muncul tanpa harus mode superuser -->
        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('scada_plc_connector.group_scada_viewer'))]"/>
        </record>

        <!-- 2. SCADA User: Supervisor / Teknisi Maintenance (Acknowledge alarm, monitoring) -->
        <record id="group_scada_user" model="res.groups">
            <field name="name">SCADA User</field>
            <field name="category_id" ref="module_category_scada_plc"/>
            <field name="implied_ids" eval="[(4, ref('group_scada_viewer'))]"/>
            <field name="comment">Dapat mengakui (acknowledge) alarm, melihat riwayat telemetri, dan mencatat tindakan maintenance.</field>
        </record>

        <!-- 3. SCADA Engineer: Engineer Otomasi (Konfigurasi koneksi, tag, rule, write ke PLC) -->
        <record id="group_scada_engineer" model="res.groups">
            <field name="name">SCADA Engineer</field>
            <field name="category_id" ref="module_category_scada_plc"/>
            <field name="implied_ids" eval="[(4, ref('group_scada_user'))]"/>
            <field name="comment">Dapat mengonfigurasi gateway, koneksi PLC, tag, rule engine, dan mengeksekusi penulisan register.</field>
        </record>

        <!-- 4. SCADA Administrator: Admin Sistem / IT (Pengaturan, API Key, Audit Log, Whitelist) -->
        <record id="group_scada_admin" model="res.groups">
            <field name="name">SCADA Administrator</field>
            <field name="category_id" ref="module_category_scada_plc"/>
            <field name="implied_ids" eval="[(4, ref('group_scada_engineer'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Akses administratif penuh, pemeliharaan API key, retensi data, pengaturan IEC 62443, dan override mode.</field>
        </record>

        <!-- Hubungkan Administrator Sistem (base.group_system) agar selalu memiliki akses SCADA Administrator -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('scada_plc_connector.group_scada_admin'))]"/>
        </record>

        <!-- Multi-Company Record Rules -->
        <record id="scada_connection_company_rule" model="ir.rule">
            <field name="name">SCADA Connection Multi-Company</field>
            <field name="model_id" ref="model_scada_connection"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="scada_device_company_rule" model="ir.rule">
            <field name="name">SCADA Device Multi-Company</field>
            <field name="model_id" ref="model_scada_device"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="scada_tag_company_rule" model="ir.rule">
            <field name="name">SCADA Tag Multi-Company</field>
            <field name="model_id" ref="model_scada_tag"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="scada_gateway_company_rule" model="ir.rule">
            <field name="name">SCADA Gateway Multi-Company</field>
            <field name="model_id" ref="model_scada_gateway"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>

