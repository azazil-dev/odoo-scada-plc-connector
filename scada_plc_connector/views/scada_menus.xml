<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Top-Level Root Menu -->
    <menuitem id="menu_scada_root"
              name="SCADA &amp; PLC"
              web_icon="scada_plc_connector,static/description/icon.png"
              groups="scada_plc_connector.group_scada_viewer"
              sequence="25"/>

    <!-- 1. Monitoring Menu -->
    <menuitem id="menu_scada_monitoring"
              name="Monitoring"
              parent="menu_scada_root"
              sequence="10"/>

    <record id="action_scada_tag_live" model="ir.actions.act_window">
        <field name="name">Tag Live Telemetry</field>
        <field name="res_model">scada.tag</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada tag yang terdaftar. Buat tag baru atau impor dari file CSV.
            </p>
        </field>
    </record>

    <menuitem id="menu_scada_tag_live"
              name="Tag Live"
              parent="menu_scada_monitoring"
              action="action_scada_tag_live"
              sequence="10"/>

    <record id="action_scada_device" model="ir.actions.act_window">
        <field name="name">Perangkat &amp; Mesin</field>
        <field name="res_model">scada.device</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_scada_device"
              name="Mesin Pabrik"
              parent="menu_scada_monitoring"
              action="action_scada_device"
              sequence="20"/>

    <record id="action_scada_alarm" model="ir.actions.act_window">
        <field name="name">Alarm &amp; Peringatan Mesin</field>
        <field name="res_model">scada.alarm</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_scada_alarm_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada alarm mesin yang terpicu.
            </p>
            <p>
                Sistem akan secara otomatis mencatat alarm ketika pembacaan tag PLC melanggar aturan ambang batas (scada.rule).
            </p>
        </field>
    </record>

    <menuitem id="menu_scada_alarm"
              name="Daftar Alarm"
              parent="menu_scada_monitoring"
              action="action_scada_alarm"
              sequence="30"/>

    <!-- 3. Operasional & Keamanan (Audit Tulis PLC) -->
    <menuitem id="menu_scada_security"
              name="Audit &amp; Kontrol"
              parent="menu_scada_root"
              groups="scada_plc_connector.group_scada_engineer"
              sequence="20"/>

    <record id="action_scada_write_request" model="ir.actions.act_window">
        <field name="name">Antrean Perintah Tulis PLC</field>
        <field name="res_model">scada.write.request</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem id="menu_scada_write_request"
              name="Perintah Tulis PLC"
              parent="menu_scada_security"
              action="action_scada_write_request"
              sequence="10"/>

    <record id="action_scada_log" model="ir.actions.act_window">
        <field name="name">Audit Log (IEC 62443)</field>
        <field name="res_model">scada.log</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem id="menu_scada_log"
              name="Audit Log IEC 62443"
              parent="menu_scada_security"
              action="action_scada_log"
              groups="scada_plc_connector.group_scada_admin"
              sequence="20"/>

    <!-- 2. Konfigurasi Menu -->
    <menuitem id="menu_scada_config"
              name="Konfigurasi"
              parent="menu_scada_root"
              groups="scada_plc_connector.group_scada_engineer"
              sequence="30"/>

    <record id="action_scada_gateway" model="ir.actions.act_window">
        <field name="name">Edge Gateways</field>
        <field name="res_model">scada.gateway</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_scada_gateway"
              name="Gateway"
              parent="menu_scada_config"
              action="action_scada_gateway"
              sequence="10"/>

    <record id="action_scada_connection" model="ir.actions.act_window">
        <field name="name">Koneksi PLC</field>
        <field name="res_model">scada.connection</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_scada_connection"
              name="Koneksi PLC"
              parent="menu_scada_config"
              action="action_scada_connection"
              sequence="20"/>

    <menuitem id="menu_scada_tag_config"
              name="Daftar Tag"
              parent="menu_scada_config"
              action="action_scada_tag_live"
              sequence="30"/>

    <menuitem id="menu_scada_tag_import"
              name="Import Tag CSV"
              parent="menu_scada_config"
              action="action_scada_tag_import_wizard"
              sequence="35"/>

    <record id="action_scada_rule" model="ir.actions.act_window">
        <field name="name">Rule &amp; Aksi Otomatis</field>
        <field name="res_model">scada.rule</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_scada_rule"
              name="Rule dan Aksi"
              parent="menu_scada_config"
              action="action_scada_rule"
              sequence="40"/>

    <record id="action_scada_mapping" model="ir.actions.act_window">
        <field name="name">Mapping Tag ke Odoo (MRP/Field)</field>
        <field name="res_model">scada.mapping</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_scada_mapping"
              name="Mapping ke Odoo"
              parent="menu_scada_config"
              action="action_scada_mapping"
              sequence="50"/>

    <menuitem id="menu_scada_settings"
              name="Pengaturan"
              parent="menu_scada_config"
              action="action_scada_config_settings"
              groups="scada_plc_connector.group_scada_admin"
              sequence="90"/>

</odoo>

