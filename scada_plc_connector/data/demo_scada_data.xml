<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 1. Gateway Simulator Default -->
        <record id="demo_scada_gateway_main" model="scada.gateway">
            <field name="name">Gateway Utama Pabrik (Lini Produksi A)</field>
            <field name="code">GW-PLANT-01</field>
            <field name="mode">embedded</field>
            <field name="status">online</field>
            <field name="last_heartbeat" eval="datetime.now().strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="version">1.0.0-ce</field>
            <field name="host_os">Linux Ubuntu 22.04 LTS (x86_64)</field>
            <field name="buffer_queue_size">0</field>
            <field name="api_key_hash">8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918</field>
        </record>

        <!-- 2. Koneksi Simulator & Modbus -->
        <record id="demo_scada_conn_simulator" model="scada.connection">
            <field name="name">PLC Lini Produksi 1 (Simulator Bawaan)</field>
            <field name="code">CONN-SIM-01</field>
            <field name="gateway_id" ref="demo_scada_gateway_main"/>
            <field name="protocol">simulator</field>
            <field name="host">127.0.0.1</field>
            <field name="port">502</field>
            <field name="state">online</field>
            <field name="last_seen" eval="datetime.now().strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="latency_ms">1.2</field>
            <field name="poll_interval_default">1.0</field>
        </record>

        <record id="demo_scada_conn_modbus" model="scada.connection">
            <field name="name">PLC Modbus TCP CNC Wood Router</field>
            <field name="code">CONN-MODBUS-02</field>
            <field name="gateway_id" ref="demo_scada_gateway_main"/>
            <field name="protocol">modbus_tcp</field>
            <field name="host">192.168.1.120</field>
            <field name="port">502</field>
            <field name="unit_id">1</field>
            <field name="state">online</field>
            <field name="last_seen" eval="datetime.now().strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="latency_ms">4.5</field>
            <field name="poll_interval_default">2.0</field>
        </record>

        <!-- 3. Perangkat / Mesin -->
        <record id="demo_scada_dev_cnc" model="scada.device">
            <field name="name">Mesin CNC Wood Milling 5-Axis</field>
            <field name="code">MCH-CNC-01</field>
            <field name="connection_id" ref="demo_scada_conn_simulator"/>
            <field name="state">running</field>
            <field name="description">Mesin pembentuk komponen furniture kayu jati presisi tinggi.</field>
        </record>

        <record id="demo_scada_dev_dryer" model="scada.device">
            <field name="name">Kiln Drying Chamber (Ruang Pengering Kayu)</field>
            <field name="code">MCH-KILN-02</field>
            <field name="connection_id" ref="demo_scada_conn_simulator"/>
            <field name="state">running</field>
            <field name="description">Pengering kayu otomatis dengan kontrol kelembaban &amp; temperatur.</field>
        </record>

        <!-- 4. Tag Telemetri -->
        <record id="demo_tag_spindle_temp" model="scada.tag">
            <field name="name">Suhu Spindle Motor Utama</field>
            <field name="code">CNC_SPINDLE_TEMP</field>
            <field name="connection_id" ref="demo_scada_conn_simulator"/>
            <field name="device_id" ref="demo_scada_dev_cnc"/>
            <field name="address">SIM:TEMP_01</field>
            <field name="data_type">float32</field>
            <field name="unit">°C</field>
            <field name="mode">read_write</field>
            <field name="is_writable" eval="True"/>
            <field name="min_write_value">20.0</field>
            <field name="max_write_value">120.0</field>
        </record>

        <record id="demo_tag_spindle_rpm" model="scada.tag">
            <field name="name">Kecepatan Putaran Spindle</field>
            <field name="code">CNC_SPINDLE_RPM</field>
            <field name="connection_id" ref="demo_scada_conn_simulator"/>
            <field name="device_id" ref="demo_scada_dev_cnc"/>
            <field name="address">SIM:RPM</field>
            <field name="data_type">float32</field>
            <field name="unit">RPM</field>
            <field name="mode">read</field>
        </record>

        <record id="demo_tag_prod_counter" model="scada.tag">
            <field name="name">Counter Produk Jadi (Pieces)</field>
            <field name="code">CNC_PROD_COUNTER</field>
            <field name="connection_id" ref="demo_scada_conn_simulator"/>
            <field name="device_id" ref="demo_scada_dev_cnc"/>
            <field name="address">SIM:COUNTER</field>
            <field name="data_type">int32</field>
            <field name="unit">pcs</field>
            <field name="mode">read</field>
        </record>

        <record id="demo_tag_kiln_temp" model="scada.tag">
            <field name="name">Suhu Ruang Kiln Chamber</field>
            <field name="code">KILN_CHAMBER_TEMP</field>
            <field name="connection_id" ref="demo_scada_conn_simulator"/>
            <field name="device_id" ref="demo_scada_dev_dryer"/>
            <field name="address">SIM:TEMP_02</field>
            <field name="data_type">float32</field>
            <field name="unit">°C</field>
            <field name="mode">read_write</field>
            <field name="is_writable" eval="True"/>
            <field name="min_write_value">30.0</field>
            <field name="max_write_value">90.0</field>
        </record>

        <record id="demo_tag_kiln_pressure" model="scada.tag">
            <field name="name">Tekanan Sirkulasi Udara</field>
            <field name="code">KILN_AIR_PRESSURE</field>
            <field name="connection_id" ref="demo_scada_conn_simulator"/>
            <field name="device_id" ref="demo_scada_dev_dryer"/>
            <field name="address">SIM:PRESS_01</field>
            <field name="data_type">float32</field>
            <field name="unit">bar</field>
            <field name="mode">read</field>
        </record>

        <!-- 5. Nilai Terakhir (Cache scada.tag.last) -->
        <record id="demo_last_spindle_temp" model="scada.tag.last">
            <field name="tag_id" ref="demo_tag_spindle_temp"/>
            <field name="value_str">82.4</field>
            <field name="value_num">82.4</field>
            <field name="quality">good</field>
            <field name="timestamp" eval="datetime.now().strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <record id="demo_last_spindle_rpm" model="scada.tag.last">
            <field name="tag_id" ref="demo_tag_spindle_rpm"/>
            <field name="value_str">1480.0</field>
            <field name="value_num">1480.0</field>
            <field name="quality">good</field>
            <field name="timestamp" eval="datetime.now().strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <record id="demo_last_prod_counter" model="scada.tag.last">
            <field name="tag_id" ref="demo_tag_prod_counter"/>
            <field name="value_str">342</field>
            <field name="value_num">342.0</field>
            <field name="quality">good</field>
            <field name="timestamp" eval="datetime.now().strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <record id="demo_last_kiln_temp" model="scada.tag.last">
            <field name="tag_id" ref="demo_tag_kiln_temp"/>
            <field name="value_str">68.5</field>
            <field name="value_num">68.5</field>
            <field name="quality">good</field>
            <field name="timestamp" eval="datetime.now().strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <!-- 6. Rule & Alarm Otomatis -->
        <record id="demo_rule_overheat" model="scada.rule">
            <field name="name">Deteksi Overheat Spindle CNC (> 85 °C)</field>
            <field name="tag_id" ref="demo_tag_spindle_temp"/>
            <field name="operator">gt</field>
            <field name="threshold_value">85.0</field>
            <field name="severity">danger</field>
            <field name="duration_seconds">10</field>
            <field name="hysteresis">2.0</field>
        </record>

        <record id="demo_action_maintenance" model="scada.action">
            <field name="rule_id" ref="demo_rule_overheat"/>
            <field name="action_type">maintenance</field>
            <field name="maintenance_title">Pemeriksaan Sistem Pelumasan &amp; Pendingin Spindle CNC</field>
        </record>
    </data>
</odoo>

